<?xml version="1.0"?>
<package format="3">
  <name>rosnav_driver</name>
  <version>1.0.0</version>
  <description>RosNav driver — serial bridge and waypoint nav</description>
  <maintainer email="user@rosnav.local">RosNav</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
